+def seal(record):
+    record = {k: v for k, v in record.items() if k != "record_sha256"}
+    record["record_sha256"] = hashlib.sha256(
+        json.dumps(
+            record, ensure_ascii=False, sort_keys=True, separators=(",", ":")
+        ).encode()
+    ).hexdigest()
+    return record
+
