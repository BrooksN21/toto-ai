+                0o600, dir_fd=fd,
+            )
+        except FileExistsError as error:
+            raise ValueError("stale watcher temporary file exists") from error
+        created = True
+        with os.fdopen(writer, "w", encoding="utf-8") as handle:
+            handle.write(value)
+            handle.flush()
+            os.fsync(handle.fileno())
+        _writable_entry(fd, path.name)
