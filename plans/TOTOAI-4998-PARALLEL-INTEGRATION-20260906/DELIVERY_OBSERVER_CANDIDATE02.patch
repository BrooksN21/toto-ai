+        created = False
+        os.fsync(fd)
+    finally:
+        if created:
+            os.unlink(temporary, dir_fd=fd)
+        os.close(fd)
+
+
+def _append_text(path: Path, value: str) -> None:
+    fd = _directory_fd(path.parent)
+    try:
+        _writable_entry(fd, path.name)
+        writer = os.open(
+            path.name, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW,
+            0o600, dir_fd=fd,
+        )
+        with os.fdopen(writer, "a", encoding="utf-8") as handle:
+            handle.write(value)
+            handle.flush()
+            os.fsync(handle.fileno())
