+def _retry_locked(
+    *,
+    cached: GoalProbeCollection,
+    retry_root: Path,
+    retry_of: str,
+    drawing_id: int,
+    raw_cache_dir: str | Path,
+    output: Path,
+    api_key: str,
+    request_budget: int,
+    root: Path,
+    observed: datetime,
