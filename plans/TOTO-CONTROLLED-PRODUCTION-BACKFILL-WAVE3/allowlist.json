  "selection_sql": "WITH counts AS (\n SELECT d.id,d.number,d.status,COUNT(e.id) AS event_count,\n SUM(CASE WHEN e.result IN ('1','X','2') OR lower(COALESCE(e.result_status,'')) IN ('void','cancelled','canceled') THEN 1 ELSE 0 END) AS terminal_count\n FROM drawings d JOIN events e ON e.drawing_id=d.id\n WHERE d.number < 4940 AND lower(d.status)='finished'\n GROUP BY d.id,d.number,d.status\n), states AS (\n SELECT r.* FROM drawing_reconciliation_states r\n WHERE r.provider='totobrief'\n)\nSELECT c.*,s.classification,s.retry_state,s.next_eligible_at,s.attempt_count,s.terminal_count AS state_terminal_count\nFROM counts c LEFT JOIN states s ON s.drawing_id=c.id\nWHERE c.terminal_count<15\nORDER BY CASE WHEN c.terminal_count=0 THEN 0 ELSE 1 END, c.number DESC"
}
