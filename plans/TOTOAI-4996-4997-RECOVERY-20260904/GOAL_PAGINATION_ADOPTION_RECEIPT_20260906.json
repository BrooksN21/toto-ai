  "test_harness_source": "import hashlib, json, os, sys\nfrom pathlib import Path\nMAIN = Path('/Users/turshevr/toto-ai')\nTEMP = Path(__file__).parent.resolve()\nsys.dont_write_bytecode = True\nblocked = []\ndef audit(event, args):\n    if event.startswith(('socket.connect', 'socket.getaddrinfo', 'socket.gethostby', 'socket.sendto', 'subprocess.Popen', 'os.system', 'os.posix_spawn', 'os.exec')) or event == 'sqlite3.connect':\n        blocked.append({'event': event, 'test': os.environ.get('PYTEST_CURRENT_TEST')})\n        raise RuntimeError('local finalization forbids network/process/DB access: ' + event)\n    paths = []\n    if event == 'open' and isinstance(args[0], (str, bytes, os.PathLike)):\n        path, mode, flags = args\n        resolved = Path(os.fsdecode(path)).resolve()\n        if (isinstance(mode, str) and any(c in mode for c in 'wax+')) or (isinstance(flags, int) and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND)):\n            paths = [path]\n        elif resolved.name.startswith('.env') and not resolved.is_relative_to(TEMP):\n            raise RuntimeError('local finalization forbids real secret-file reads')\n    elif event in ('os.mkdir', 'os.remove', 'os.rmdir', 'os.chmod', 'os.utime'):\n        paths = [args[0]]\n    elif event in ('os.rename', 'os.link', 'os.symlink'):\n        paths = [args[0], args[1]]\n    for path in paths:\n        if isinstance(path, (str, bytes, os.PathLike)) and not Path(os.fsdecode(path)).resolve().is_relative_to(TEMP):\n            blocked.append({'event': event, 'test': os.environ.get('PYTEST_CURRENT_TEST')})\n            raise RuntimeError('local finalization forbids writes outside temporary test root')\nsys.addaudithook(audit)\nsys.path[:0] = [str(MAIN), str(MAIN / 'src')]\nimport toto_ai.external_odds.goal_api as goal\nassert Path(goal.__file__).resolve() == MAIN / 'src/toto_ai/external_odds/goal_api.py'\nassert hashlib.sha256(Path(goal.__file__).read_bytes()).hexdigest() == '73d6d9e6185c35fab07565ce0566c15f869ad19f907547ab70f89bed5b28ccbb'\nimport pytest\nfiles = ['tests/test_goal_api_pagination_identity.py', 'tests/test_goal_api_provider.py', 'tests/test_goal_api_schedule_collection.py', 'tests/test_schedule_source_collector.py']\ncode = pytest.main(['-q', '-x', '--tb=short', '-p', 'no:cacheprovider', '-c', str(MAIN / 'pyproject.toml'), '--rootdir', str(MAIN), '--basetemp', str(TEMP / 'pytest-main'), '--log-file', str(TEMP / 'pytest.log'), *[str(MAIN / f) for f in files]])\nloaded = {}\nfor key, value in list(sys.modules.items()):\n    if key.startswith(('toto_ai', 'tests')) and getattr(value, '__file__', None):\n        path = Path(value.__file__).resolve()\n        if path.suffix == '.py' and path.is_file():\n            loaded[str(path)] = hashlib.sha256(path.read_bytes()).hexdigest()\n(TEMP / 'runtime.json').write_text(json.dumps({'exit_code': code, 'blocked_actions': blocked, 'loaded_source_sha256': loaded}, indent=2))\nraise SystemExit(code)\n",
